{
  "name": "drone-operations-console",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Jason Stys",
  "description": "Private simulator-only drone fleet console and cooperative route rehearsal",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write ui tests/browser desktop tests/desktop tests/desktop-lifetime tools/*.mjs package.json tsconfig.json vite.config.ts playwright*.config.ts",
    "format:check": "prettier --check ui tests/browser desktop tests/desktop tests/desktop-lifetime tools/*.mjs package.json tsconfig.json vite.config.ts playwright*.config.ts",
    "audit": "npm audit --audit-level=high",
    "desktop": "electron .",
    "package:desktop": "electron-builder --win nsis --publish never",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:lifecycle": "node --test --experimental-test-coverage --test-coverage-include=desktop/owned-lifetime.cjs --test-coverage-include=desktop/resources.cjs --test-coverage-include=desktop/private-directory.cjs --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 tests/desktop-lifetime/*.test.cjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "dev.jasonstys.droneconsole",
    "productName": "Drone Operations Console",
    "directories": {
      "output": "release/installers"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "runtime/${version}/ui"
      },
      {
        "from": "release/drone-console-service",
        "to": "runtime/${version}/service"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signExecutable": false,
      "icon": "ui/public/app-icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "Drone Operations Console"
    }
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  }
}
